    // =========================================================================
    // WORD-LEVEL INLINE DIFF ENGINE & GRAMMAR FIXES RENDERER
    // =========================================================================
    function computeWordDiffHtml(originalText, correctedText) {
      if (!originalText && !correctedText) return '<span class="text-slate-400 italic">No text available to compare.</span>';
      if (!originalText) return `<span class="diff-ins">${escapeHtml(correctedText)}</span>`;
      if (!correctedText) return escapeHtml(originalText);

      // Tokenize preserving whitespace
      const origTokens = originalText.split(/(\s+)/);
      const corrTokens = correctedText.split(/(\s+)/);

      // Guard against huge texts by falling back to sentence-level diff if > 1400 tokens
      if (origTokens.length * corrTokens.length > 2000000) {
        return computeSentenceDiffHtml(originalText, correctedText);
      }

      const n = origTokens.length;
      const m = corrTokens.length;
      const dp = Array.from({ length: n + 1 }, () => new Int32Array(m + 1));

      for (let i = n - 1; i >= 0; i--) {
        for (let j = m - 1; j >= 0; j--) {
          if (origTokens[i] === corrTokens[j]) {
            dp[i][j] = 1 + dp[i + 1][j + 1];
          } else {
            dp[i][j] = Math.max(dp[i + 1][j], dp[i][j + 1]);
          }
        }
      }

      let i = 0, j = 0;
      let html = "";
      while (i < n && j < m) {
        if (origTokens[i] === corrTokens[j]) {
          html += escapeHtml(origTokens[i]);
          i++;
          j++;
        } else if (dp[i + 1][j] >= dp[i][j + 1]) {
          const tok = origTokens[i];
          html += /^\s+$/.test(tok) ? tok : `<span class="diff-del">${escapeHtml(tok)}</span>`;
          i++;
        } else {
          const tok = corrTokens[j];
          html += /^\s+$/.test(tok) ? tok : `<span class="diff-ins">${escapeHtml(tok)}</span>`;
          j++;
        }
      }

      while (i < n) {
        const tok = origTokens[i++];
        html += /^\s+$/.test(tok) ? tok : `<span class="diff-del">${escapeHtml(tok)}</span>`;
      }
      while (j < m) {
        const tok = corrTokens[j++];
        html += /^\s+$/.test(tok) ? tok : `<span class="diff-ins">${escapeHtml(tok)}</span>`;
      }

      return html;
    }

    function computeSentenceDiffHtml(originalText, correctedText) {
      const origSents = originalText.split(/(?<=[.!?])\s+/);
      const corrSents = correctedText.split(/(?<=[.!?])\s+/);
      const maxLen = Math.max(origSents.length, corrSents.length);
      let out = [];
      for (let k = 0; k < maxLen; k++) {
        const o = origSents[k] || "";
        const c = corrSents[k] || "";
        if (o === c) {
          out.push(escapeHtml(c));
        } else {
          if (o) out.push(`<span class="diff-del">${escapeHtml(o)}</span>`);
          if (c) out.push(`<span class="diff-ins">${escapeHtml(c)}</span>`);
        }
      }
      return out.join(" ");
    }

