<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>System Audio Note Taker</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            studio: {
              bg: '#0f172a',
              card: '#1e293b',
              border: '#334155',
            }
          }
        }
      }
    };
  </script>

  <style>
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(148, 163, 184, 0.35);
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(148, 163, 184, 0.55);
    }

    /* Inline Grammar Diff Styling */
    .diff-del {
      background-color: rgba(244, 63, 94, 0.16);
      color: #fb7185;
      text-decoration: line-through;
      padding: 1px 4px;
      border-radius: 4px;
      margin-right: 3px;
    }
    html:not(.dark) .diff-del {
      background-color: rgba(244, 63, 94, 0.12);
      color: #e11d48;
    }

    .diff-ins {
      background-color: rgba(16, 185, 129, 0.18);
      color: #34d399;
      font-weight: 500;
      padding: 1px 5px;
      border-radius: 4px;
      border-bottom: 1.5px solid #10b981;
    }
    html:not(.dark) .diff-ins {
      background-color: rgba(16, 185, 129, 0.14);
      color: #059669;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 dark:bg-[#0b0f19] dark:text-slate-100 font-sans antialiased transition-colors duration-200 min-h-screen flex flex-col">

  <!-- Top Navigation Bar -->
  <header class="sticky top-0 z-30 bg-white/85 dark:bg-[#0b0f19]/90 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 px-4 sm:px-6 py-3">
    <div class="max-w-[1600px] mx-auto flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <!-- Mobile Sidebar Toggle -->
        <button id="mobileSidebarBtn" class="lg:hidden p-2 rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition" title="Toggle Saved Sessions">
          <i data-lucide="panel-left" class="w-5 h-5"></i>
        </button>

        <!-- Logo & Title -->
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-indigo-600 flex items-center justify-center text-white shadow-md shadow-indigo-500/25">
            <i data-lucide="audio-waveform" class="w-5 h-5"></i>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h1 class="text-base sm:text-lg font-bold tracking-tight leading-none">System Audio Note Taker</h1>
              <span class="hidden sm:inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30">
                Whole-System Audio + Grammar AI
              </span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 hidden sm:block mt-1">Capture entire laptop system sound (Zoom, Air Class, desktop apps, tabs), auto-correct grammar, and summarize</p>
          </div>
        </div>
      </div>

      <!-- Status Pill & Action Controls -->
      <div class="flex items-center gap-2 sm:gap-3">
        <!-- Live Status Badge -->
        <div id="statusBadge" class="flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium bg-slate-100 text-slate-700 dark:bg-[#1e293b] dark:text-slate-300 border border-slate-200 dark:border-slate-700 transition-all">
          <span id="statusDot" class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span id="statusText">Ready</span>
        </div>

        <!-- Setup Guide Button -->
        <button id="openGuideBtn" class="flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-medium bg-indigo-50 text-indigo-700 hover:bg-indigo-100 dark:bg-indigo-950/70 dark:text-indigo-300 dark:hover:bg-indigo-900/70 border border-indigo-200/70 dark:border-indigo-800/70 transition">
          <i data-lucide="help-circle" class="w-4 h-4"></i>
          <span class="hidden md:inline">Audio Setup</span>
        </button>

        <!-- Theme Toggle -->
        <button id="themeToggleBtn" class="p-2 rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700 transition" title="Toggle Light/Dark Mode">
          <i data-lucide="moon" class="w-4 h-4 dark:hidden"></i>
          <i data-lucide="sun" class="w-4 h-4 hidden dark:block"></i>
        </button>
      </div>
    </div>
  </header>

  <!-- Toast Notification Banner -->
  <div id="toastContainer" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none px-4 sm:px-0"></div>

  <!-- Main Workspace Container -->
  <div class="flex-1 max-w-[1600px] w-full mx-auto flex relative overflow-hidden">

    <!-- Saved Sessions Sidebar -->
    <aside id="notesSidebar" class="fixed lg:static inset-y-0 left-0 z-40 w-72 xl:w-80 bg-white dark:bg-[#0f172a] border-r border-slate-200 dark:border-slate-800 flex flex-col transform -translate-x-full lg:translate-x-0 transition-transform duration-200 ease-in-out pt-16 lg:pt-0 shrink-0">
      <div class="p-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between gap-2">
        <button id="newNoteBtn" class="flex-1 flex items-center justify-center gap-2 px-3 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium shadow-sm shadow-indigo-500/20 transition cursor-pointer">
          <i data-lucide="plus" class="w-4 h-4"></i>
          <span>New Session</span>
        </button>
        <button id="closeSidebarBtn" class="lg:hidden p-2 rounded-xl text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <!-- Search Sessions -->
      <div class="p-3 border-b border-slate-100 dark:border-slate-800/80">
        <div class="relative">
          <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
          <input id="searchNotesInput" type="text" placeholder="Search transcripts & notes..." class="w-full pl-9 pr-3 py-2 text-xs rounded-xl bg-slate-100 dark:bg-[#1e293b] border border-transparent focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 outline-none transition" />
        </div>
      </div>

      <!-- Sessions List -->
      <div id="savedNotesList" class="flex-1 overflow-y-auto p-3 space-y-2">
        <!-- Populated dynamically -->
      </div>

      <!-- Storage Footer -->
      <div class="p-3 border-t border-slate-200 dark:border-slate-800 text-xs text-slate-500 dark:text-slate-400 flex items-center justify-between">
        <span id="notesCountLabel">0 saved sessions</span>
        <span>Local Studio</span>
      </div>
    </aside>

    <!-- Mobile Sidebar Backdrop -->
    <div id="sidebarBackdrop" class="fixed inset-0 bg-slate-950/60 backdrop-blur-xs z-30 hidden lg:hidden"></div>

    <!-- Main Studio Workspace -->
    <main class="flex-1 flex flex-col min-w-0 p-4 sm:p-6 space-y-5 overflow-y-auto">

      <!-- Missing System Audio Warning Banner -->
      <div id="missingAudioBanner" class="hidden rounded-2xl bg-amber-50 dark:bg-amber-950/50 border border-amber-300 dark:border-amber-800 p-4 shadow-xs">
        <div class="flex items-start gap-3">
          <div class="p-2 rounded-xl bg-amber-100 dark:bg-amber-900/60 text-amber-700 dark:text-amber-300 shrink-0">
            <i data-lucide="volume-x" class="w-5 h-5"></i>
          </div>
          <div class="flex-1">
            <h3 class="text-sm font-semibold text-amber-900 dark:text-amber-200">No System Audio Track Detected</h3>
            <p class="text-xs text-amber-800 dark:text-amber-300/90 mt-1 leading-relaxed">
              Your screen was shared, but the <strong>"Also share system audio"</strong> checkbox in the browser popup was unchecked. Select <strong>Entire Screen</strong> and check <strong>Also share system audio</strong> to capture all laptop sound.
            </p>
            <div class="mt-3 flex flex-wrap items-center gap-2">
              <button id="retryCaptureBtn" class="px-3 py-1.5 rounded-lg bg-amber-600 hover:bg-amber-700 text-white text-xs font-medium transition cursor-pointer">
                Retry & Check System Audio Box
              </button>
              <button id="dismissBannerBtn" class="px-3 py-1.5 rounded-lg text-amber-800 dark:text-amber-300 hover:bg-amber-200/50 dark:hover:bg-amber-900/50 text-xs font-medium transition cursor-pointer">
                Dismiss
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Single Tab vs Whole System Notice Banner -->
      <div id="singleTabWarningBanner" class="hidden rounded-2xl bg-sky-50 dark:bg-sky-950/50 border border-sky-300 dark:border-sky-800 p-4 shadow-xs">
        <div class="flex items-start gap-3">
          <div class="p-2 rounded-xl bg-sky-100 dark:bg-sky-900/60 text-sky-700 dark:text-sky-300 shrink-0">
            <i data-lucide="app-window" class="w-5 h-5"></i>
          </div>
          <div class="flex-1">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-sm font-semibold text-sky-900 dark:text-sky-200">Single Browser Tab Detected (Not Whole Laptop Audio)</h3>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-sky-500/20 text-sky-700 dark:text-sky-300">Tab-Only Mode</span>
            </div>
            <p class="text-xs text-sky-800 dark:text-sky-300/90 mt-1 leading-relaxed">
              You shared a single browser tab, so desktop apps (Zoom, Air Class, Teams, media players) will not be heard. To capture <strong>100% of your laptop's system sound</strong>, switch to the <strong>Entire Screen</strong> tab in the picker and check <strong>Also share system audio</strong>.
            </p>
            <div class="mt-3 flex flex-wrap items-center gap-2">
              <button id="switchToWholeSystemBtn" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-sky-600 hover:bg-sky-500 text-white text-xs font-semibold transition cursor-pointer">
                <i data-lucide="monitor-speaker" class="w-3.5 h-3.5"></i>
                <span>Switch to Whole System Audio</span>
              </button>
              <button id="dismissTabWarningBtn" class="px-3 py-1.5 rounded-lg text-sky-800 dark:text-sky-300 hover:bg-sky-200/50 dark:hover:bg-sky-900/50 text-xs font-medium transition cursor-pointer">
                Keep Single Tab
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Audio Capture Control Deck -->
      <section class="bg-white dark:bg-[#1e293b] rounded-2xl border border-slate-200 dark:border-slate-700/80 p-4 sm:p-5 shadow-sm space-y-4">
        <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-4">
          <!-- Primary Recording & Input Controls -->
          <div class="flex flex-wrap items-center gap-2.5">
            <button id="captureBtn" class="flex items-center gap-2.5 px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 active:scale-[0.99] text-white font-semibold text-sm shadow-md shadow-indigo-500/25 transition cursor-pointer">
              <i data-lucide="monitor-speaker" class="w-4 h-4"></i>
              <span>Capture Whole System Sound</span>
            </button>

            <button id="pauseResumeBtn" class="hidden items-center gap-2 px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-white font-semibold text-sm shadow-xs transition cursor-pointer">
              <i data-lucide="pause" class="w-4 h-4"></i>
              <span>Pause</span>
            </button>

            <button id="stopBtn" class="hidden items-center gap-2 px-4 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-semibold text-sm shadow-xs transition cursor-pointer">
              <i data-lucide="square" class="w-4 h-4 fill-current"></i>
              <span>Stop & Process</span>
            </button>

            <!-- Upload Audio -->
            <label class="flex items-center gap-2 px-3.5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200/80 dark:border-slate-700 text-xs font-medium cursor-pointer transition" title="Upload MP3, WAV, M4A, or WebM audio">
              <i data-lucide="upload" class="w-3.5 h-3.5 text-indigo-500"></i>
              <span>Upload Audio</span>
              <input id="audioUploadInput" type="file" accept="audio/*,video/webm,video/mp4" class="hidden" />
            </label>

            <!-- Quick Paste Text Mode Button -->
            <button id="quickPasteModalBtn" class="flex items-center gap-2 px-3.5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200/80 dark:border-slate-700 text-xs font-medium transition cursor-pointer" title="Paste raw text to run Grammar Correction & Summary without recording">
              <i data-lucide="clipboard-paste" class="w-3.5 h-3.5 text-emerald-500"></i>
              <span>Quick Paste Text</span>
            </button>
          </div>

          <!-- Timer, Audio Player & Live Surface Source Readout -->
          <div class="flex flex-wrap items-center gap-3">
            <!-- Audio Playback & Download Pill -->
            <div id="audioPlayerContainer" class="hidden items-center gap-2 bg-slate-100 dark:bg-slate-800/90 px-2.5 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700">
              <audio id="recordedAudioPlayer" controls class="h-7 max-w-[200px] sm:max-w-[240px]"></audio>
              <button id="downloadAudioBtn" class="flex items-center gap-1 px-2.5 py-1 rounded-lg bg-indigo-600/15 hover:bg-indigo-600/25 text-indigo-600 dark:text-indigo-300 text-xs font-semibold transition cursor-pointer" title="Download recorded audio (.webm)">
                <i data-lucide="download" class="w-3.5 h-3.5"></i>
                <span>.webm</span>
              </button>
            </div>

            <!-- Live Timer & Surface Detection Pill -->
            <div class="flex items-center gap-3 bg-slate-50 dark:bg-[#0b0f19] px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-700/80">
              <div class="flex items-center gap-2">
                <span id="recIndicator" class="w-2.5 h-2.5 rounded-full bg-slate-400 dark:bg-slate-600"></span>
                <span id="timerDisplay" class="font-mono text-base font-semibold tracking-wider">00:00</span>
              </div>
              <div class="h-4 w-px bg-slate-200 dark:bg-slate-700"></div>
              <div id="surfaceBadge" class="flex items-center gap-1.5 text-xs font-medium text-slate-500 dark:text-slate-400">
                <i id="surfaceIcon" data-lucide="monitor" class="w-3.5 h-3.5 text-indigo-500"></i>
                <span id="audioSourceLabel">Idle</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Inline Whole-System Audio Setup Guide Strip -->
        <div class="rounded-xl bg-indigo-50/70 dark:bg-[#0b0f19]/90 border border-indigo-200/80 dark:border-indigo-500/25 px-3.5 py-2.5 flex flex-col lg:flex-row lg:items-center justify-between gap-2.5 text-xs">
          <div class="flex flex-wrap items-center gap-2 text-slate-700 dark:text-slate-300">
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-indigo-600 text-white font-semibold text-[11px]">
              <i data-lucide="laptop" class="w-3 h-3"></i>
              Whole-System Sound Guide
            </span>
            <span><strong>Windows (Chrome/Edge):</strong> Click <em>Capture Whole System Sound</em> → select <strong>"Entire Screen"</strong> tab → check <strong>"Also share system audio"</strong> → Share.</span>
          </div>
          <div class="text-[11px] text-slate-500 dark:text-slate-400 shrink-0">
            <strong>macOS:</strong> Chrome 130+ supports Screen System Audio, or use BlackHole loopback.
          </div>
        </div>

        <!-- Secondary Toggles & Dual Level Meters Row -->
        <div class="flex flex-wrap items-center justify-between gap-4 pt-3 border-t border-slate-100 dark:border-slate-700/60">
          <div class="flex flex-wrap items-center gap-5">
            <!-- Include Microphone Toggle -->
            <label class="inline-flex items-center gap-2.5 cursor-pointer select-none">
              <input id="includeMicToggle" type="checkbox" class="sr-only peer" />
              <div class="w-9 h-5 bg-slate-200 dark:bg-slate-700 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-indigo-600 relative"></div>
              <span class="text-xs font-medium text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                <i data-lucide="mic" class="w-3.5 h-3.5 text-indigo-400"></i>
                Include Microphone (Mix Both Sides)
              </span>
            </label>

            <!-- Live Auto-Transcribe & Grammar Check Toggle -->
            <label class="inline-flex items-center gap-2.5 cursor-pointer select-none" title="Processes rolling audio chunks every ~20s so transcript, grammar corrections, and summary update live">
              <input id="liveChunkToggle" type="checkbox" checked class="sr-only peer" />
              <div class="w-9 h-5 bg-slate-200 dark:bg-slate-700 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-emerald-600 relative"></div>
              <span class="text-xs font-medium text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                <i data-lucide="sparkles" class="w-3.5 h-3.5 text-emerald-400"></i>
                Live Auto-Transcribe & Grammar Check (20s)
              </span>
            </label>

            <!-- Instant Browser Mic Captions -->
            <label class="inline-flex items-center gap-2.5 cursor-pointer select-none" title="Instant local browser speech recognition captions for your microphone">
              <input id="browserSpeechToggle" type="checkbox" class="sr-only peer" />
              <div class="w-9 h-5 bg-slate-200 dark:bg-slate-700 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-sky-600 relative"></div>
              <span class="text-xs font-medium text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                <i data-lucide="captions" class="w-3.5 h-3.5 text-sky-400"></i>
                Instant Mic Captions
              </span>
            </label>
          </div>

          <!-- Independent System Audio & Mic Level Meters -->
          <div class="flex items-center gap-3 text-[11px] font-medium text-slate-500 dark:text-slate-400">
            <div class="flex items-center gap-1.5" title="Live System Sound Input Level">
              <i data-lucide="volume-2" class="w-3.5 h-3.5 text-emerald-400"></i>
              <span>System</span>
              <div class="w-16 h-2 rounded-full bg-slate-200 dark:bg-slate-800 overflow-hidden">
                <div id="sysLevelBar" class="h-full w-0 bg-emerald-500 transition-all duration-75"></div>
              </div>
            </div>
            <div class="flex items-center gap-1.5" title="Live Microphone Input Level">
              <i data-lucide="mic" class="w-3.5 h-3.5 text-indigo-400"></i>
              <span>Mic</span>
              <div class="w-16 h-2 rounded-full bg-slate-200 dark:bg-slate-800 overflow-hidden">
                <div id="micLevelBar" class="h-full w-0 bg-indigo-500 transition-all duration-75"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Compact Real-Time Waveform Visualizer Bar -->
        <div class="relative w-full h-16 rounded-xl bg-slate-950 overflow-hidden border border-slate-800 flex items-center justify-center">
          <canvas id="visualizerCanvas" class="w-full h-full block"></canvas>
          <div id="visualizerPlaceholder" class="absolute inset-0 flex items-center justify-center gap-2 text-slate-400 pointer-events-none px-4 text-center">
            <i data-lucide="bar-chart-2" class="w-4 h-4 text-indigo-400"></i>
            <p class="text-xs font-medium">Real-Time Whole-System Audio Visualizer — Click <span class="text-indigo-400 font-semibold">Capture Whole System Sound</span> or <span class="text-emerald-400 font-semibold">Quick Paste Text</span></p>
          </div>
        </div>
      </section>

      <!-- Workspace Header, View Switcher & Global Export Toolbar -->
      <section class="bg-white dark:bg-[#1e293b] rounded-2xl border border-slate-200 dark:border-slate-700/80 p-4 sm:p-5 shadow-sm space-y-4 flex-1 flex flex-col">

        <!-- Title & Controls Bar -->
        <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-4 pb-4 border-b border-slate-200 dark:border-slate-700/70">
          <!-- Session Title Input -->
          <div class="flex-1 min-w-0">
            <input id="noteTitleInput" type="text" value="Untitled System Audio Session" placeholder="Enter session, class, or meeting title..." class="w-full text-lg sm:text-xl font-bold bg-transparent border-none outline-none focus:ring-0 text-slate-900 dark:text-white placeholder-slate-400 truncate" />
            <div class="flex flex-wrap items-center gap-2.5 mt-1 text-xs text-slate-500 dark:text-slate-400">
              <span id="noteDateLabel">Today</span>
              <span>•</span>
              <span id="noteDurationLabel">00:00 duration</span>
              <span>•</span>
              <span id="autoSaveLabel" class="text-emerald-600 dark:text-emerald-400 font-medium">Saved</span>
            </div>
          </div>

          <!-- View Switcher, Re-run AI & Export Actions -->
          <div class="flex flex-wrap items-center gap-2">
            <!-- Layout Switcher: Side-by-Side Split vs Tabbed View -->
            <div class="inline-flex rounded-xl bg-slate-100 dark:bg-[#0f172a] p-1 border border-slate-200 dark:border-slate-700">
              <button id="splitViewBtn" class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-white dark:bg-[#1e293b] text-indigo-600 dark:text-indigo-400 shadow-xs transition cursor-pointer" title="View all 3 panels side-by-side">
                <i data-lucide="columns-3" class="w-3.5 h-3.5"></i>
                <span class="hidden sm:inline">Split View</span>
              </button>
              <button id="tabViewBtn" class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition cursor-pointer" title="Focus on one tab at a time">
                <i data-lucide="layout-list" class="w-3.5 h-3.5"></i>
                <span class="hidden sm:inline">Tabs</span>
              </button>
            </div>

            <!-- Re-run Grammar & Summary -->
