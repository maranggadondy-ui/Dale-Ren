    // =========================================================================
    // INTERACTIVE ACTION ITEMS RENDERER
    // =========================================================================
    function renderActionItems(items = []) {
      if (!items || items.length === 0) {
        el.actionItemsList.innerHTML = `<p class="text-xs text-slate-400 italic">No action items yet. Click "+ Add Task" or run AI Summary.</p>`;
