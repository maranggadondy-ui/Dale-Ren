    // =========================================================================
    // AUDIO VISUALIZER & DUAL LEVEL METERS (WEB AUDIO API ANALYSERNODE)
    // =========================================================================
    function resizeVisualizerCanvas() {
      const canvas = el.visualizerCanvas;
      if (!canvas) return;
      const rect = canvas.parentElement.getBoundingClientRect();
      canvas.width = rect.width * window.devicePixelRatio;
      canvas.height = rect.height * window.devicePixelRatio;
    }

    window.addEventListener("resize", resizeVisualizerCanvas);
    window.addEventListener("load", () => {
      resizeVisualizerCanvas();
      applyWorkspaceLayout();
    });

    function computeRmsPercent(analyser) {
      if (!analyser) return 0;
      const arr = new Uint8Array(analyser.frequencyBinCount);
      analyser.getByteTimeDomainData(arr);
      let sum = 0;
      for (let i = 0; i < arr.length; i++) {
        const v = (arr[i] - 128) / 128;
        sum += v * v;
      }
      const rms = Math.sqrt(sum / arr.length);
      return Math.min(100, Math.round(rms * 360));
    }

    function startVisualizer(analyser) {
      resizeVisualizerCanvas();
      el.visualizerPlaceholder.classList.add("hidden");

      const canvas = el.visualizerCanvas;
      const ctx = canvas.getContext("2d");
      const bufferLength = analyser.frequencyBinCount;
      const dataArray = new Uint8Array(bufferLength);

      function draw() {
        state.animationFrameId = requestAnimationFrame(draw);
        analyser.getByteFrequencyData(dataArray);

        // Update independent System & Mic level bars
        if (el.sysLevelBar) {
          el.sysLevelBar.style.width = `${state.isPaused ? 0 : computeRmsPercent(state.sysAnalyserNode)}%`;
        }
        if (el.micLevelBar) {
          el.micLevelBar.style.width = `${state.isPaused ? 0 : computeRmsPercent(state.micAnalyserNode)}%`;
        }

        const width = canvas.width;
        const height = canvas.height;
        ctx.clearRect(0, 0, width, height);

        const barCount = 72;
        const step = Math.floor(bufferLength / barCount);
        const totalBarSpace = width / barCount;
        const barWidth = Math.max(2 * window.devicePixelRatio, totalBarSpace * 0.62);

        for (let i = 0; i < barCount; i++) {
          const val = dataArray[i * step] || 0;
          const percent = val / 255;
          const barHeight = Math.max(3 * window.devicePixelRatio, percent * (height * 0.82));

          const x = i * totalBarSpace + (totalBarSpace - barWidth) / 2;
          const y = (height - barHeight) / 2;

          const gradient = ctx.createLinearGradient(0, y, 0, y + barHeight);
          gradient.addColorStop(0, "#818cf8");
          gradient.addColorStop(0.5, "#6366f1");
          gradient.addColorStop(1, "#10b981");

          ctx.fillStyle = state.isPaused ? "rgba(245, 158, 11, 0.55)" : gradient;
          ctx.beginPath();
          ctx.roundRect(x, y, barWidth, barHeight, 4 * window.devicePixelRatio);
          ctx.fill();
        }
      }

      draw();
    }

    function stopVisualizer() {
      if (state.animationFrameId) {
        cancelAnimationFrame(state.animationFrameId);
        state.animationFrameId = null;
      }
      if (el.sysLevelBar) el.sysLevelBar.style.width = "0%";
      if (el.micLevelBar) el.micLevelBar.style.width = "0%";
      const canvas = el.visualizerCanvas;
      const ctx = canvas.getContext("2d");
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      el.visualizerPlaceholder.classList.remove("hidden");
    }

    // =========================================================================
    // WHOLE-SYSTEM SOUND + OPTIONAL MIC CAPTURE ENGINE
    // =========================================================================
    async function startSystemAudioCapture() {
      el.missingAudioBanner.classList.add("hidden");
      el.singleTabWarningBanner.classList.add("hidden");

      if (!navigator.mediaDevices || !navigator.mediaDevices.getDisplayMedia) {
        showToast("Your browser does not support system audio capture via getDisplayMedia.", "error");
        return;
      }

      try {
        // Configure getDisplayMedia to favor Entire Screen / Whole-System Audio
        const displayStream = await navigator.mediaDevices.getDisplayMedia({
          video: {
            displaySurface: "monitor",
          },
          audio: {
            echoCancellation: false,
            noiseSuppression: false,
            autoGainControl: false,
            suppressLocalAudioPlayback: false,
          },
          systemAudio: "include",
          surfaceSwitching: "include",
          selfBrowserSurface: "exclude",
          preferCurrentTab: false,
        });

        // Inspect displaySurface before stopping the video track
        const videoTrack = displayStream.getVideoTracks()[0];
        const videoSettings = videoTrack ? videoTrack.getSettings() : {};
        const surfaceType = videoSettings.displaySurface || "unknown";
        state.capturedSurfaceType = surfaceType;

        // Immediately stop the video track once inspected so zero screen video is recorded
        displayStream.getVideoTracks().forEach(track => track.stop());

        const systemAudioTracks = displayStream.getAudioTracks();
        if (systemAudioTracks.length === 0) {
          displayStream.getTracks().forEach(t => t.stop());
          el.missingAudioBanner.classList.remove("hidden");
          showToast("No system audio track found. Select 'Entire Screen' and check 'Also share system audio'.", "warning");
          return;
        }

        state.displayStream = displayStream;

        systemAudioTracks[0].onended = () => {
          if (state.isRecording) stopRecordingAndTranscribe();
        };

        let micStream = null;
        if (el.includeMicToggle.checked) {
          try {
            micStream = await navigator.mediaDevices.getUserMedia({
              audio: {
                echoCancellation: true,
                noiseSuppression: true,
                autoGainControl: true,
              }
            });
            state.micStream = micStream;
          } catch (micErr) {
            showToast("Microphone permission denied. Recording Whole System Audio only.", "warning");
            el.includeMicToggle.checked = false;
          }
        }

        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        const audioCtx = new AudioCtx();
        state.audioContext = audioCtx;

        const destination = audioCtx.createMediaStreamDestination();
        const analyser = audioCtx.createAnalyser();
        analyser.fftSize = 256;
        analyser.smoothingTimeConstant = 0.8;

        const sysAnalyser = audioCtx.createAnalyser();
        sysAnalyser.fftSize = 128;

        const systemSource = audioCtx.createMediaStreamSource(new MediaStream(systemAudioTracks));
        systemSource.connect(destination);
        systemSource.connect(analyser);
        systemSource.connect(sysAnalyser);

        state.sysAnalyserNode = sysAnalyser;
        state.micAnalyserNode = null;

        const hasMic = Boolean(micStream && micStream.getAudioTracks().length > 0);
        if (hasMic) {
          const micAnalyser = audioCtx.createAnalyser();
          micAnalyser.fftSize = 128;

          const micSource = audioCtx.createMediaStreamSource(micStream);
          micSource.connect(destination);
          micSource.connect(analyser);
          micSource.connect(micAnalyser);
          state.micAnalyserNode = micAnalyser;
        }

        // Update live surface status badge & warn if only a single browser tab was selected
        if (surfaceType === "monitor") {
          el.audioSourceLabel.textContent = hasMic ? "Whole System + Mic" : "Whole System Audio";
          el.surfaceBadge.className = "flex items-center gap-1.5 text-xs font-semibold text-emerald-600 dark:text-emerald-400";
        } else if (surfaceType === "browser") {
          el.audioSourceLabel.textContent = hasMic ? "Single Tab + Mic" : "Single Browser Tab";
          el.surfaceBadge.className = "flex items-center gap-1.5 text-xs font-semibold text-sky-600 dark:text-sky-400";
          el.singleTabWarningBanner.classList.remove("hidden");
        } else {
          el.audioSourceLabel.textContent = hasMic ? "System + Mic" : "System Audio";
          el.surfaceBadge.className = "flex items-center gap-1.5 text-xs font-semibold text-indigo-600 dark:text-indigo-400";
        }

        state.analyserNode = analyser;

        const supportedTypes = [
          "audio/webm;codecs=opus",
          "audio/webm",
          "audio/ogg;codecs=opus",
          "audio/mp4"
        ];
        const chosenMime = supportedTypes.find(type => MediaRecorder.isTypeSupported(type)) || "";
        state.mimeType = chosenMime || "audio/webm";

        state.audioChunks = [];
        const recorder = chosenMime
          ? new MediaRecorder(destination.stream, { mimeType: chosenMime })
          : new MediaRecorder(destination.stream);

        recorder.ondataavailable = (event) => {
          if (event.data && event.data.size > 0) {
            state.audioChunks.push(event.data);
          }
        };

        recorder.onstop = handleRecordingStopped;
        recorder.start(1000);
        state.mediaRecorder = recorder;

        state.isRecording = true;
        state.isPaused = false;
        state.startTime = Date.now();
        state.pausedDuration = 0;

        updateCaptureControlsUI(true);
        startVisualizer(analyser);
        startTimer();

        if (el.liveChunkToggle.checked) {
          startLiveChunkedTranscription();
        }
        if (el.browserSpeechToggle.checked) {
          startBrowserSpeechRecognition();
        }

        if (surfaceType === "monitor") {
          setAppStatus("Listening to Whole System Sound", "recording");
          showToast("Whole-system audio capture active! Capturing all laptop sound.", "success");
        } else if (surfaceType === "browser") {
          setAppStatus("Listening to Single Tab Audio", "recording");
          showToast("Single browser tab audio active. Switch to 'Entire Screen' for full laptop sound.", "info");
        } else {
          setAppStatus("Listening to System Audio", "recording");
          showToast("System audio capture active!", "success");
        }

      } catch (err) {
        if (err.name === "NotAllowedError") {
          showToast("Capture prompt was cancelled.", "info");
        } else {
          showToast(`Capture failed: ${err.message}`, "error");
        }
      }
    }

    async function switchToWholeSystemCapture() {
      // Cleanly abort current single-tab capture without overwriting notes, then re-open picker
      if (state.isRecording) {
        state.isRecording = false;
        state.isPaused = false;
        clearInterval(state.timerInterval);
        clearInterval(state.chunkInterval);
        stopBrowserSpeechRecognition();
        stopVisualizer();

        if (state.mediaRecorder && state.mediaRecorder.state !== "inactive") {
          state.mediaRecorder.onstop = null;
          state.mediaRecorder.stop();
        }
        if (state.displayStream) {
          state.displayStream.getTracks().forEach(t => t.stop());
          state.displayStream = null;
        }
        if (state.micStream) {
          state.micStream.getTracks().forEach(t => t.stop());
          state.micStream = null;
        }
        if (state.audioContext) {
          state.audioContext.close().catch(() => {});
          state.audioContext = null;
        }
        updateCaptureControlsUI(false);
      }
      await startSystemAudioCapture();
    }

