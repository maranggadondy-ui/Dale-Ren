      const now = new Date();
      const newNote = {
        id: "session_" + Date.now(),
        title: `Session — ${now.toLocaleDateString(undefined, { month: "short", day: "numeric" })} ${now.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })}`,
        createdAt: now.toISOString(),
        duration: "00:00",
        transcript: "",
        grammarCorrected: "",
        grammarFixes: [],
        execSummary: "",
        keyTakeaways: "",
        actionItems: [],
        keyTerms: "",
      };

      state.notes.unshift(newNote);
      saveNotesToStorage();
      selectNote(newNote.id);
      renderNotesSidebar();
      toggleMobileSidebar(false);

      el.audioPlayerContainer.classList.add("hidden");
      state.recordedBlob = null;
      el.timerDisplay.textContent = "00:00";

