    // =========================================================================
    // AUDIO VISUALIZER (WEB AUDIO API ANALYSERNODE)
    // =========================================================================
    function resizeVisualizerCanvas() {
      const canvas = el.visualizerCanvas;
      if (!canvas) return;
      const rect = canvas.parentElement.getBoundingClientRect();
      canvas.width = rect.width * window.devicePixelRatio;
      canvas.height = rect.height * window.devicePixelRatio;
    }

    window.addEventListener("resize", resizeVisualizerCanvas);
    window.addEventListener("load", () => {
      resizeVisualizerCanvas();
      applyWorkspaceLayout();
    });

    function startVisualizer(analyser) {
      resizeVisualizerCanvas();
      el.visualizerPlaceholder.classList.add("hidden");

      const canvas = el.visualizerCanvas;
      const ctx = canvas.getContext("2d");
      const bufferLength = analyser.frequencyBinCount;
      const dataArray = new Uint8Array(bufferLength);

      function draw() {
        state.animationFrameId = requestAnimationFrame(draw);
        analyser.getByteFrequencyData(dataArray);

        const width = canvas.width;
        const height = canvas.height;
        ctx.clearRect(0, 0, width, height);

        const barCount = 72;
        const step = Math.floor(bufferLength / barCount);
        const totalBarSpace = width / barCount;
        const barWidth = Math.max(2 * window.devicePixelRatio, totalBarSpace * 0.62);

        for (let i = 0; i < barCount; i++) {
          const val = dataArray[i * step] || 0;
          const percent = val / 255;
          const barHeight = Math.max(3 * window.devicePixelRatio, percent * (height * 0.82));

          const x = i * totalBarSpace + (totalBarSpace - barWidth) / 2;
          const y = (height - barHeight) / 2;

          const gradient = ctx.createLinearGradient(0, y, 0, y + barHeight);
          gradient.addColorStop(0, "#818cf8");
          gradient.addColorStop(0.5, "#6366f1");
          gradient.addColorStop(1, "#10b981");

          ctx.fillStyle = state.isPaused ? "rgba(245, 158, 11, 0.55)" : gradient;
          ctx.beginPath();
          ctx.roundRect(x, y, barWidth, barHeight, 4 * window.devicePixelRatio);
          ctx.fill();
        }
      }

      draw();
    }

    function stopVisualizer() {
      if (state.animationFrameId) {
        cancelAnimationFrame(state.animationFrameId);
        state.animationFrameId = null;
      }
      const canvas = el.visualizerCanvas;
      const ctx = canvas.getContext("2d");
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      el.visualizerPlaceholder.classList.remove("hidden");
    }

    // =========================================================================
    // SYSTEM SOUND + OPTIONAL MIC CAPTURE ENGINE
    // =========================================================================
    async function startSystemAudioCapture() {
      el.missingAudioBanner.classList.add("hidden");

      if (!navigator.mediaDevices || !navigator.mediaDevices.getDisplayMedia) {
        showToast("Your browser does not support system audio capture via getDisplayMedia.", "error");
        return;
      }

      try {
        const displayStream = await navigator.mediaDevices.getDisplayMedia({
          video: true,
          audio: {
            echoCancellation: false,
            noiseSuppression: false,
            autoGainControl: false,
          }
        });

        // Immediately stop video track for privacy
        displayStream.getVideoTracks().forEach(track => track.stop());

        const systemAudioTracks = displayStream.getAudioTracks();
        if (systemAudioTracks.length === 0) {
          displayStream.getTracks().forEach(t => t.stop());
          el.missingAudioBanner.classList.remove("hidden");
          showToast("No system audio track found. Check 'Share system audio' in the popup.", "warning");
          return;
        }

        state.displayStream = displayStream;

        systemAudioTracks[0].onended = () => {
          if (state.isRecording) stopRecordingAndTranscribe();
        };

        let micStream = null;
        if (el.includeMicToggle.checked) {
          try {
            micStream = await navigator.mediaDevices.getUserMedia({
              audio: {
                echoCancellation: true,
                noiseSuppression: true,
                autoGainControl: true,
              }
            });
            state.micStream = micStream;
          } catch (micErr) {
            showToast("Microphone permission denied. Recording System Audio only.", "warning");
            el.includeMicToggle.checked = false;
          }
        }

        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        const audioCtx = new AudioCtx();
        state.audioContext = audioCtx;

        const destination = audioCtx.createMediaStreamDestination();
        const analyser = audioCtx.createAnalyser();
        analyser.fftSize = 256;
        analyser.smoothingTimeConstant = 0.8;

        const systemSource = audioCtx.createMediaStreamSource(new MediaStream(systemAudioTracks));
        systemSource.connect(destination);
        systemSource.connect(analyser);

        if (micStream && micStream.getAudioTracks().length > 0) {
          const micSource = audioCtx.createMediaStreamSource(micStream);
          micSource.connect(destination);
          micSource.connect(analyser);
          el.audioSourceLabel.textContent = "System + Mic";
        } else {
          el.audioSourceLabel.textContent = "System Sound";
        }

        state.analyserNode = analyser;

        const supportedTypes = [
          "audio/webm;codecs=opus",
          "audio/webm",
          "audio/ogg;codecs=opus",
          "audio/mp4"
        ];
        const chosenMime = supportedTypes.find(type => MediaRecorder.isTypeSupported(type)) || "";
        state.mimeType = chosenMime || "audio/webm";

        state.audioChunks = [];
        const recorder = chosenMime
          ? new MediaRecorder(destination.stream, { mimeType: chosenMime })
          : new MediaRecorder(destination.stream);

        recorder.ondataavailable = (event) => {
          if (event.data && event.data.size > 0) {
            state.audioChunks.push(event.data);
          }
        };

        recorder.onstop = handleRecordingStopped;
        recorder.start(1000);
        state.mediaRecorder = recorder;

        state.isRecording = true;
        state.isPaused = false;
        state.startTime = Date.now();
        state.pausedDuration = 0;

        updateCaptureControlsUI(true);
        startVisualizer(analyser);
        startTimer();

        if (el.liveChunkToggle.checked) {
          startLiveChunkedTranscription();
        }
        if (el.browserSpeechToggle.checked) {
          startBrowserSpeechRecognition();
        }

        setAppStatus("Listening to System Audio", "recording");
        showToast("System audio capture active! Play your meeting, video, or lecture.", "success");

      } catch (err) {
        if (err.name === "NotAllowedError") {
          showToast("Capture prompt was cancelled.", "info");
        } else {
          showToast(`Capture failed: ${err.message}`, "error");
        }
      }
    }

    function togglePauseResume() {
      if (!state.isRecording || !state.mediaRecorder) return;

      if (!state.isPaused) {
        state.mediaRecorder.pause();
        state.isPaused = true;
        state.lastPauseStart = Date.now();
        el.pauseResumeBtn.innerHTML = `<i data-lucide="play" class="w-4 h-4"></i><span>Resume</span>`;
        el.recIndicator.className = "w-2.5 h-2.5 rounded-full bg-amber-500";
        setAppStatus("Recording Paused", "paused");
      } else {
        state.mediaRecorder.resume();
        state.isPaused = false;
        state.pausedDuration += Date.now() - state.lastPauseStart;
        el.pauseResumeBtn.innerHTML = `<i data-lucide="pause" class="w-4 h-4"></i><span>Pause</span>`;
        el.recIndicator.className = "w-2.5 h-2.5 rounded-full bg-rose-500 animate-ping";
        setAppStatus("Listening to System Audio", "recording");
      }
      lucide.createIcons({ root: el.pauseResumeBtn });
    }

    function stopRecordingAndTranscribe() {
      if (!state.isRecording) return;
      state.isRecording = false;
      state.isPaused = false;

      clearInterval(state.timerInterval);
      clearInterval(state.chunkInterval);
      stopBrowserSpeechRecognition();
      stopVisualizer();

      if (state.mediaRecorder && state.mediaRecorder.state !== "inactive") {
        state.mediaRecorder.stop();
      }

      if (state.displayStream) {
        state.displayStream.getTracks().forEach(t => t.stop());
        state.displayStream = null;
      }
      if (state.micStream) {
        state.micStream.getTracks().forEach(t => t.stop());
        state.micStream = null;
      }
      if (state.audioContext) {
        state.audioContext.close().catch(() => {});
        state.audioContext = null;
      }
      state.sysAnalyserNode = null;
      state.micAnalyserNode = null;

      el.singleTabWarningBanner.classList.add("hidden");
      updateCaptureControlsUI(false);
      el.audioSourceLabel.textContent = "Recorded";
      el.surfaceBadge.className = "flex items-center gap-1.5 text-xs font-medium text-slate-500 dark:text-slate-400";
    }

    async function handleRecordingStopped() {
      if (state.audioChunks.length === 0) {
        setAppStatus("Ready", "idle");
        return;
      }

      const blob = new Blob(state.audioChunks, { type: state.mimeType });
      state.recordedBlob = blob;

      if (state.recordedAudioUrl) URL.revokeObjectURL(state.recordedAudioUrl);
      state.recordedAudioUrl = URL.createObjectURL(blob);

      el.recordedAudioPlayer.src = state.recordedAudioUrl;
      el.audioPlayerContainer.classList.remove("hidden");
      el.audioPlayerContainer.classList.add("flex");

      const finalDuration = el.timerDisplay.textContent;
      el.noteDurationLabel.textContent = `${finalDuration} duration`;
      updateCurrentNoteField("duration", finalDuration);

      await processAudioWithGemini(blob, false);
    }

    function updateCaptureControlsUI(recording) {
      if (recording) {
        el.captureBtn.classList.add("hidden");
        el.pauseResumeBtn.classList.remove("hidden");
        el.pauseResumeBtn.classList.add("flex");
        el.stopBtn.classList.remove("hidden");
        el.stopBtn.classList.add("flex");
        el.recIndicator.className = "w-2.5 h-2.5 rounded-full bg-rose-500 animate-ping";
      } else {
        el.captureBtn.classList.remove("hidden");
        el.pauseResumeBtn.classList.add("hidden");
        el.pauseResumeBtn.classList.remove("flex");
        el.stopBtn.classList.add("hidden");
        el.stopBtn.classList.remove("flex");
        el.recIndicator.className = "w-2.5 h-2.5 rounded-full bg-slate-400 dark:bg-slate-600";
      }
    }

    function startTimer() {
      clearInterval(state.timerInterval);
      state.timerInterval = setInterval(() => {
        if (state.isPaused) return;
        const elapsedSec = Math.floor((Date.now() - state.startTime - state.pausedDuration) / 1000);
        el.timerDisplay.textContent = formatDuration(elapsedSec);
      }, 500);
    }

    el.captureBtn.addEventListener("click", startSystemAudioCapture);
    el.retryCaptureBtn.addEventListener("click", startSystemAudioCapture);
    el.dismissBannerBtn.addEventListener("click", () => el.missingAudioBanner.classList.add("hidden"));
    el.switchToWholeSystemBtn.addEventListener("click", switchToWholeSystemCapture);
    el.dismissTabWarningBtn.addEventListener("click", () => el.singleTabWarningBanner.classList.add("hidden"));
    el.pauseResumeBtn.addEventListener("click", togglePauseResume);
    el.stopBtn.addEventListener("click", stopRecordingAndTranscribe);

    // =========================================================================
    // LIVE 20s ROLLING TRANSCRIPTION + GRAMMAR CHECK + RUNNING SUMMARY
    // =========================================================================
    function startLiveChunkedTranscription() {
      clearInterval(state.chunkInterval);
      state.chunkInterval = setInterval(async () => {
        if (!state.isRecording || state.isPaused || state.isProcessingAI) return;
        if (state.audioChunks.length < 3) return;

        const snapshotBlob = new Blob(state.audioChunks, { type: state.mimeType });
        if (snapshotBlob.size > 9 * 1024 * 1024) return;

        await processAudioWithGemini(snapshotBlob, true);
      }, 20000);
    }

    function startBrowserSpeechRecognition() {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SpeechRecognition) {
        showToast("Browser SpeechRecognition API is not supported in this browser.", "warning");
        el.browserSpeechToggle.checked = false;
        return;
      }

      const recognition = new SpeechRecognition();
      recognition.continuous = true;
      recognition.interimResults = true;
      recognition.lang = navigator.language || "en-US";

      let finalized = el.transcriptTextarea.value ? el.transcriptTextarea.value + "\n" : "";

      recognition.onresult = (event) => {
        let interim = "";
        for (let i = event.resultIndex; i < event.results.length; i++) {
          const transcript = event.results[i][0].transcript;
          if (event.results[i].isFinal) {
            finalized += transcript.trim() + " ";
          } else {
            interim += transcript;
          }
        }
        el.transcriptTextarea.value = finalized + (interim ? `[Live Mic: ${interim}]` : "");
        updateWordCount();
      };

      recognition.onerror = () => {};
      recognition.onend = () => {
        if (state.isRecording && el.browserSpeechToggle.checked) {
          try { recognition.start(); } catch (e) {}
        }
      };

      try {
        recognition.start();
        state.speechRecognition = recognition;
      } catch (e) {}
    }

    function stopBrowserSpeechRecognition() {
      if (state.speechRecognition) {
        try { state.speechRecognition.stop(); } catch (e) {}
        state.speechRecognition = null;
      }
    }

    // =========================================================================
    // AUDIO UPLOAD & DOWNLOAD
    // =========================================================================
    el.audioUploadInput.addEventListener("change", async (e) => {
      const file = e.target.files?.[0];
      if (!file) return;

      if (state.isRecording) {
        showToast("Stop current recording before uploading an audio file.", "warning");
        return;
      }

      state.recordedBlob = file;
      state.mimeType = file.type || "audio/webm";
      if (state.recordedAudioUrl) URL.revokeObjectURL(state.recordedAudioUrl);
      state.recordedAudioUrl = URL.createObjectURL(file);

      el.recordedAudioPlayer.src = state.recordedAudioUrl;
      el.audioPlayerContainer.classList.remove("hidden");
      el.audioPlayerContainer.classList.add("flex");
      el.audioSourceLabel.textContent = "Uploaded File";

      const cleanName = file.name.replace(/\.[^/.]+$/, "");
      el.noteTitleInput.value = cleanName;
      updateCurrentNoteField("title", cleanName);

      showToast(`Loaded "${file.name}". Processing audio...`, "info");
      await processAudioWithGemini(file, false);
      e.target.value = "";
    });

    el.downloadAudioBtn.addEventListener("click", () => {
      if (!state.recordedBlob) {
        showToast("No recorded audio available to download.", "warning");
        return;
      }
      const a = document.createElement("a");
      a.href = state.recordedAudioUrl;
      const safeTitle = (el.noteTitleInput.value || "system-audio").replace(/[^a-z0-9-_]+/gi, "_").toLowerCase();
      a.download = `${safeTitle}.webm`;
      a.click();
    });

    // =========================================================================
    // GEMINI API: MULTIMODAL AUDIO & TEXT -> TRANSCRIPT + GRAMMAR + SUMMARY
    // =========================================================================
    function blobToBase64(blob) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onloadend = () => resolve(reader.result.split(",")[1]);
        reader.onerror = reject;
        reader.readAsDataURL(blob);
      });
    }

    async function fetchGeminiWithBackoff(payload, maxRetries = 4) {
      const url = `https://generativelanguage.googleapis.com/v1beta/models/${GEMINI_MODEL}:generateContent?key=${apiKey}`;
      let delay = 1000;

      for (let attempt = 0; attempt <= maxRetries; attempt++) {
        try {
          const response = await fetch(url, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });

          if (!response.ok) {
            if ((response.status === 429 || response.status >= 500) && attempt < maxRetries) {
              await new Promise(r => setTimeout(r, delay));
              delay *= 2;
              continue;
            }
            const errBody = await response.text();
            throw new Error(`API Error (${response.status}): ${errBody}`);
          }

          return await response.json();
        } catch (err) {
          if (attempt === maxRetries) throw err;
          await new Promise(r => setTimeout(r, delay));
          delay *= 2;
        }
      }
    }

    function getStructuredOutputSchema() {
      return {
        type: "OBJECT",
        properties: {
          suggestedTitle: { type: "STRING" },
          verbatimTranscript: { type: "STRING" },
          grammarCorrectedText: { type: "STRING" },
          grammarFixes: {
            type: "ARRAY",
            items: {
              type: "OBJECT",
              properties: {
                original: { type: "STRING" },
                corrected: { type: "STRING" },
                reason: { type: "STRING" }
              },
              required: ["original", "corrected", "reason"]
            }
          },
          executiveSummary: { type: "STRING" },
          keyTakeaways: {
            type: "ARRAY",
            items: { type: "STRING" }
          },
          actionItems: {
            type: "ARRAY",
            items: { type: "STRING" }
          },
          keyTerms: {
            type: "ARRAY",
            items: { type: "STRING" }
          }
        },
        required: [
          "suggestedTitle",
          "verbatimTranscript",
          "grammarCorrectedText",
          "grammarFixes",
          "executiveSummary",
          "keyTakeaways",
          "actionItems",
          "keyTerms"
        ]
      };
    }

    function getGrammarToneInstruction() {
      const tone = el.grammarToneSelect.value;
      if (tone === "professional") {
        return "Apply 'Professional Polish': fix all grammar, spelling, punctuation, run-on sentences, and filler words (um, uh, like), elevating phrasing to clear, formal, publication-ready prose while preserving exact meaning.";
      }
      return "Apply 'Standard Clean-Up': fix grammar, spelling, capitalization, punctuation, and awkward phrasing while preserving the speaker's natural conversational voice and tone.";
    }

    function applyStructuredResultToUI(parsed, isLivePreview = false) {
      if (parsed.verbatimTranscript !== undefined) {
        el.transcriptTextarea.value = parsed.verbatimTranscript;
        updateCurrentNoteField("transcript", parsed.verbatimTranscript);
        updateWordCount();
      }

      if (parsed.grammarCorrectedText !== undefined) {
        el.grammarCleanTextarea.value = parsed.grammarCorrectedText;
        updateCurrentNoteField("grammarCorrected", parsed.grammarCorrectedText);
      }

      const fixes = Array.isArray(parsed.grammarFixes) ? parsed.grammarFixes : [];
      updateCurrentNoteField("grammarFixes", fixes);
      renderGrammarFixesLog(fixes);

      if (state.grammarViewMode === "diff") {
        setGrammarDisplayMode("diff");
      }

      if (parsed.executiveSummary !== undefined) {
        el.execSummaryTextarea.value = parsed.executiveSummary;
        updateCurrentNoteField("execSummary", parsed.executiveSummary);
      }

      if (Array.isArray(parsed.keyTakeaways)) {
        const formattedTakeaways = parsed.keyTakeaways.map(t => (t.startsWith("•") ? t : `• ${t}`)).join("\n");
        el.keyTakeawaysTextarea.value = formattedTakeaways;
        updateCurrentNoteField("keyTakeaways", formattedTakeaways);
      }

      if (Array.isArray(parsed.actionItems)) {
        const note = getActiveNote();
        const existingDoneMap = new Map(
          (note?.actionItems || []).map(item => [item.text, item.done])
        );
        const mappedActions = parsed.actionItems.map(text => ({
          text,
          done: existingDoneMap.get(text) || false
        }));
        updateCurrentNoteField("actionItems", mappedActions);
        renderActionItems(mappedActions);
      }

      if (Array.isArray(parsed.keyTerms)) {
        const formattedTerms = parsed.keyTerms.map(t => (t.startsWith("•") ? t : `• ${t}`)).join("\n");
        el.keyTermsTextarea.value = formattedTerms;
        updateCurrentNoteField("keyTerms", formattedTerms);
      }

      if (!isLivePreview && parsed.suggestedTitle && el.noteTitleInput.value.startsWith("Session —")) {
        el.noteTitleInput.value = parsed.suggestedTitle;
        updateCurrentNoteField("title", parsed.suggestedTitle);
      }
    }

    async function processAudioWithGemini(audioBlob, isLivePreview = false) {
      if (state.isProcessingAI) return;
      state.isProcessingAI = true;

      if (!isLivePreview) {
        setAppStatus("Transcribing, Correcting & Summarizing...", "processing");
        el.aiProgressBanner.classList.remove("hidden");
        el.aiProgressBanner.classList.add("flex");
        el.aiProgressText.textContent = "Gemini AI is transcribing system audio, running automated grammar correction, and synthesizing your summary...";
      }

      try {
        const base64Audio = await blobToBase64(audioBlob);
        const cleanMime = (audioBlob.type || "audio/webm").split(";")[0];
        const toneInstruction = getGrammarToneInstruction();

        const payload = {
          contents: [{
            role: "user",
            parts: [
              {
                text: `Listen carefully to this recorded laptop system audio and return a structured JSON response containing:
1. "verbatimTranscript": Complete, accurate, word-for-word transcript with timestamps (e.g., [00:12]) and speaker labels (e.g., Speaker 1, Host). Keep natural speech exactly as spoken.
2. "grammarCorrectedText": The full text with automated grammar, spelling, punctuation, and fluency corrections applied (without timestamps). ${toneInstruction}
3. "grammarFixes": An array of key grammar/punctuation/phrasing fixes made (up to 15 most impactful fixes), each with "original" snippet, "corrected" snippet, and concise "reason" (e.g., "Subject-verb agreement", "Punctuation & sentence boundary", "Verb tense consistency", "Removed filler words").
4. "executiveSummary": A concise 2-4 sentence summary of the audio content.
5. "keyTakeaways": Bullet list of the main points and insights.
6. "actionItems": Specific tasks, follow-ups, or action items mentioned (empty array if none).
7. "keyTerms": Key vocabulary, concepts, tools, or names with brief definitions.
8. "suggestedTitle": A concise 4-to-7 word descriptive title.`
              },
              {
                inlineData: {
                  mimeType: cleanMime,
                  data: base64Audio
                }
              }
            ]
          }],
          generationConfig: {
            responseMimeType: "application/json",
            responseSchema: getStructuredOutputSchema()
          }
        };

        const result = await fetchGeminiWithBackoff(payload, isLivePreview ? 1 : 4);
        const rawJson = result?.candidates?.[0]?.content?.parts?.[0]?.text;

        if (rawJson) {
          const parsed = JSON.parse(rawJson);
          if (isLivePreview && !state.isRecording) return;
          applyStructuredResultToUI(parsed, isLivePreview);
          if (!isLivePreview) {
            showToast("Audio transcribed, grammar-corrected, and summarized!", "success");
          }
        }
      } catch (err) {
        if (!isLivePreview) {
          showToast(`AI processing error: ${err.message}`, "error");
        }
      } finally {
        state.isProcessingAI = false;
        if (!isLivePreview) {
          el.aiProgressBanner.classList.add("hidden");
          el.aiProgressBanner.classList.remove("flex");
          setAppStatus("Ready", "idle");
        }
      }
    }

    async function processTextWithGemini(rawText) {
      if (state.isProcessingAI) return;
      state.isProcessingAI = true;

      setAppStatus("Correcting Grammar & Summarizing...", "processing");
      el.aiProgressBanner.classList.remove("hidden");
      el.aiProgressBanner.classList.add("flex");
      el.aiProgressText.textContent = "Running automated grammar corrector and generating structured summary...";

      try {
        const toneInstruction = getGrammarToneInstruction();
        const payload = {
          contents: [{
            role: "user",
            parts: [{
              text: `Analyze the following raw transcript/text and return a structured JSON response:
1. "verbatimTranscript": Return the input text cleanly preserved.
2. "grammarCorrectedText": The full text with automated grammar, spelling, punctuation, and fluency corrections applied (removing timestamps if present). ${toneInstruction}
3. "grammarFixes": An array of key grammar/punctuation/phrasing corrections made (up to 15 most impactful fixes), each with "original" snippet, "corrected" snippet, and concise "reason" (e.g., "Subject-verb agreement", "Punctuation", "Verb tense consistency", "Clarity & phrasing").
4. "executiveSummary": A concise 2-4 sentence summary of the text.
5. "keyTakeaways": Bullet list of the main points and insights.
6. "actionItems": Specific tasks or action items mentioned (empty array if none).
7. "keyTerms": Key vocabulary, concepts, or terms with brief definitions.
8. "suggestedTitle": A concise 4-to-7 word descriptive title.

Input Text:
${rawText}`
            }]
          }],
          generationConfig: {
            responseMimeType: "application/json",
            responseSchema: getStructuredOutputSchema()
          }
        };

        const result = await fetchGeminiWithBackoff(payload);
        const rawJson = result?.candidates?.[0]?.content?.parts?.[0]?.text;

        if (rawJson) {
          const parsed = JSON.parse(rawJson);
          applyStructuredResultToUI(parsed, false);
          showToast("Grammar corrected and smart summary generated!", "success");
        }
      } catch (err) {
        showToast(`Failed to process text: ${err.message}`, "error");
      } finally {
        state.isProcessingAI = false;
        el.aiProgressBanner.classList.add("hidden");
        el.aiProgressBanner.classList.remove("flex");
        setAppStatus("Ready", "idle");
      }
    }

    // Re-run button & Tone change handler
    el.rerunAiBtn.addEventListener("click", async () => {
      const currentText = el.transcriptTextarea.value.trim();
      if (currentText) {
        await processTextWithGemini(currentText);
      } else if (state.recordedBlob) {
        await processAudioWithGemini(state.recordedBlob, false);
      } else {
        showToast("Record system audio or paste text first.", "warning");
      }
    });

    el.grammarToneSelect.addEventListener("change", async () => {
      const currentText = el.transcriptTextarea.value.trim();
      if (currentText && !state.isProcessingAI) {
        await processTextWithGemini(currentText);
      }
    });

    // =========================================================================
    // ONE-CLICK CLIPBOARD & FILE EXPORTS
    // =========================================================================
    function copyTextToClipboard(text, label) {
      if (!text || !text.trim()) {
        showToast(`No ${label} available to copy.`, "warning");
        return;
      }
      const tempArea = document.createElement("textarea");
      tempArea.value = text;
      document.body.appendChild(tempArea);
      tempArea.select();
      try {
        document.execCommand("copy");
        showToast(`${label} copied to clipboard!`, "success");
      } catch (err) {
        showToast("Unable to copy to clipboard.", "error");
      }
      document.body.removeChild(tempArea);
    }

    function buildFormattedSummaryText() {
      const note = getActiveNote();
      const exec = el.execSummaryTextarea.value.trim();
      const takeaways = el.keyTakeawaysTextarea.value.trim();
      const actions = (note?.actionItems || [])
        .map(a => `- [${a.done ? "x" : " "}] ${a.text}`)
        .join("\n");
      const terms = el.keyTermsTextarea.value.trim();

      return [
        exec ? `### Executive Summary\n${exec}` : "",
        takeaways ? `### Key Takeaways\n${takeaways}` : "",
        actions ? `### Action Items\n${actions}` : "",
        terms ? `### Key Terms & Definitions\n${terms}` : "",
      ].filter(Boolean).join("\n\n");
    }

    el.copyRawBtn.addEventListener("click", () => {
      copyTextToClipboard(el.transcriptTextarea.value, "Raw Transcript");
    });

    el.copyGrammarBtn.addEventListener("click", () => {
      copyTextToClipboard(el.grammarCleanTextarea.value, "Grammar-Corrected Text");
    });

    el.copySummaryBtn.addEventListener("click", () => {
      copyTextToClipboard(buildFormattedSummaryText(), "Smart Summary");
    });

    function buildFullExportContent() {
      const title = el.noteTitleInput.value.trim() || "Untitled System Audio Session";
      const date = el.noteDateLabel.textContent;
      const duration = el.noteDurationLabel.textContent;
      const summary = buildFormattedSummaryText();
      const grammarCorrected = el.grammarCleanTextarea.value.trim();
      const rawTranscript = el.transcriptTextarea.value.trim();

      return `# ${title}\nDate: ${date} | ${duration}\n\n---\n\n## Smart Summary\n\n${summary || "_No summary generated._"}\n\n---\n\n## Grammar-Corrected Text\n\n${grammarCorrected || "_No grammar-corrected text available._"}\n\n---\n\n## Raw Verbatim Transcript\n\n${rawTranscript || "_No transcript available._"}\n`;
    }

    function downloadTextFile(extension) {
      const content = buildFullExportContent();
      const blob = new Blob([content], { type: "text/plain;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      const safeTitle = (el.noteTitleInput.value || "system-audio-note").replace(/[^a-z0-9-_]+/gi, "_").toLowerCase();
      a.href = url;
      a.download = `${safeTitle}.${extension}`;
      a.click();
      URL.revokeObjectURL(url);
      showToast(`Exported all sections as ${safeTitle}.${extension}`, "success");
    }

    el.exportMdBtn.addEventListener("click", () => downloadTextFile("md"));
    el.exportTxtBtn.addEventListener("click", () => downloadTextFile("txt"));

    // =========================================================================
    // INITIALIZE STUDIO
    // =========================================================================
    initTheme();
    loadNotesFromStorage();
    applyWorkspaceLayout();
    setAppStatus("Ready", "idle");
  </script>
</body>
